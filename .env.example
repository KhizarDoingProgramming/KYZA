# add ur keys here
# Minimum set to get Atlas + Helix working: GEMINI_API_KEY + GROQ_API_KEY
# The app still boots (and falls back to a keyless provider) if these are empty.

# Google Gemini (Atlas primary)
GEMINI_API_KEY=

# Groq (Atlas / Helix fallback)  https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (Atlas / Helix fallback)  https://openrouter.ai/keys
OPENROUTER_API_KEY=

# DeepSeek (last cloud fallback)  https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# Cohere (Helix primary)  https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# Cerebras (optional)
CEREBRAS_API_KEY=

# Hugging Face (optional, currently unused)
HUGGINGFACE_API_KEY=
